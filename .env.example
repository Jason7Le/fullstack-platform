# 全局环境变量示例
# ========================
# 全局环境配置
# ========================

# 应用环境
NODE_ENV=development
APP_PORT=3000
# ========================
# 数据库配置 (MySQL)
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=userpassword
DB_DATABASE=user_db
DB_SYNCHRONIZE=false

# ========================
# Redis 配置
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here

# ========================
# JWT 配置 (所有服务共享)
# ========================
JWT_SECRET=d2057202075fa30aeeb74e96810cee0b1159ebeae462287d36f1881a5789279376c6a297b422734dc9cf88304a62d945b9c1587c0e42be18fc9d425fa0dce1a7
JWT_EXPIRES_IN=7d

# ========================
# 文件上传配置
# ========================
UPLOAD_MAX_FILE_SIZE=10mb
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# ========================
# 跨域配置
# ========================
CORS_ORIGIN=http://localhost:5173