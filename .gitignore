# ========================
# 环境变量文件忽略规则
# ========================

# 忽略所有实际环境变量文件
# .env
# .env.*
# !/.env.example去掉了

# # 忽略服务级环境变量
# services/*/.env
# services/*/.env.*

# # 忽略应用级环境变量
# apps/*/.env
# apps/*/.env.*

# # 但保留所有示例文件
# !**/.env.example

# ========================
# 其他忽略规则（保持原有）
# ========================
node_modules/
dist/
build/
logs/
*.log