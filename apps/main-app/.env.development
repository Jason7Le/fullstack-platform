# ========================
# 前端主应用配�?
# ========================
MODE=development
# 应用配置
VITE_APP_TITLE=全栈微前端平台
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_VERSION=1.0.0
VITE_REMOTE_DASHBOARD_URL=http://localhost:3003/assets/remoteEntry.js
VITE_WEB_VITALS_ENABLED=true
VITE_ANALYTICS_ENDPOINT=http://localhost:3001/api/analytics
# 特性开�?
VITE_FEATURE_AUTH=true
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_DARK_MODE=true

# Web Vitals 监控配置
VITE_WEB_VITALS_ENABLED=true
VITE_WEB_VITALS_PAGES=/dashboard,/dashboard-app,/login

# 微前端监控配�?
VITE_MICRO_FRONTEND_ENABLED=true
VITE_MICRO_FRONTEND_PAGES=/dashboard-app,/admin/*

# 错误监控配置
VITE_ERROR_MONITORING_ENABLED=true
VITE_ERROR_MONITORING_PAGES=/*

# 第三方服务配�?
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_GA_TRACKING_ID=your_ga_tracking_id_here
