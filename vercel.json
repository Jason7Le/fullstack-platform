{
  "version": 2,
  "builds": [],
  "buildCommand": "",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!@test\\.html|assets/|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
