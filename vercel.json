{
  "version": 2,
  "builds": [
    {
      "src": "apps/main-app/package.json", // 指向子项目的package.json
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "apps/main-app/dist" // 明确指定输出目录
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
